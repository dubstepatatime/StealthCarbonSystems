# Copy to .env.local for development. In development every value is optional:
# the app runs on an embedded database with paper trading only.
# In production the first four are required; the app refuses to run without them.

APP_URL=https://your-domain.example
DATABASE_URL=postgres://user:password@host:5432/db?sslmode=require
BETTER_AUTH_SECRET=        # openssl rand -base64 48
TOKEN_ENCRYPTION_KEY=      # openssl rand -base64 48  (encrypts Coinbase tokens at rest; keep it out of the database)
CRON_SECRET=               # openssl rand -base64 32  (Vercel Cron sends it as a bearer token)

# Coinbase OAuth client (requires Coinbase partner approval). Redirect URI: ${APP_URL}/api/coinbase/callback
COINBASE_CLIENT_ID=
COINBASE_CLIENT_SECRET=

# Stripe Billing. Webhook endpoint: ${APP_URL}/api/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PILOT=
STRIPE_PRICE_DESK=

# Optional AI analyst (Vercel AI Gateway). Without it the desk runs on its rules alone.
AI_GATEWAY_API_KEY=
# AI_MODEL=anthropic/claude-sonnet-4.6

# Operator kill switch: set to 1 to stop all trading for everyone.
# TRADING_HALTED=1
